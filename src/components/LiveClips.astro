---
import YouTubeEmbed from './YouTubeEmbed.astro';
import {path} from '../lib/paths';
import type { CollectionEntry } from 'astro:content';
interface Props { videos: CollectionEntry<'songs'>['data']['videos']; sectionId?: string; headingLevel?: 2 | 3 }
const { videos, sectionId='live-videos', headingLevel=2 } = Astro.props;
const Heading = `h${headingLevel}`;
---
<section id={sectionId}><Heading>官方現場與公開演唱片段</Heading>
  <p class="muted">演唱會、節目與棚內演唱依影片原標題區分。未明載日期的片段不補日期；公開片段不等於完整歌單。展開後仍需點選播放才載入 YouTube。</p>
  {videos.map(v=><details class="clip-details"><summary>{v.title}</summary><p class="muted">{v.performedOn?<>明載演出日期：<time datetime={v.performedOn}>{v.performedOn}</time></>:'影片未明載單一演出日期。'}{v.publishedOn&&<> · 影片公開：{v.publishedOn}</>}</p>{v.concertId&&<p><a href={path(`live/${v.concertId}/`)}>閱讀同日完整歌單與來源 →</a></p>}<YouTubeEmbed id={v.youtubeId} title={v.title} kind={v.kind} headingLevel={headingLevel===2?3:4} externalOnly={v.externalOnly} restrictionNote={v.restrictionNote}/></details>)}
</section>
