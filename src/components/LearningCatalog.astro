---
import { songLyrics } from '../data/lyrics-learning';
import { loadContent } from '../lib/content';
import { path } from '../lib/paths';
const { songs } = await loadContent();
const covered=songs.filter(song=>songLyrics[song.id]);
---
<section id="learning-catalog" aria-labelledby="learning-catalog-title">
  <h2 id="learning-catalog-title">可在本站逐行練習的作品</h2>
  <p>{covered.length} 首可在本站逐行閱讀，搭配振假名、全假名、羅馬拼音與中文翻譯。點選歌名進入學習區；其他作品可由外部學習連結繼續探索。</p>
  <ul class="learning-catalog">{covered.map(song=><li><a href={path(`songs/${song.id}/#learning`)}><span lang="ja">{song.data.titleJa}</span><small>{song.data.titleZh.text} · {songLyrics[song.id]!.lines.length} 句</small></a></li>)}</ul>
</section>
<style>
  .learning-catalog{list-style:none;padding:0;display:grid;gap:0 24px}
  .learning-catalog li{margin:0;border-bottom:1px solid var(--line)}
  .learning-catalog a{display:block;padding-block:12px;min-height:44px;text-decoration:none}
  .learning-catalog small{display:block;color:var(--muted)}
  @media(min-width:720px){.learning-catalog{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>
