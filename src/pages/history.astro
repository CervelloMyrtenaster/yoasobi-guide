---
import BaseLayout from '../layouts/BaseLayout.astro';
import HistoryArchive from '../components/HistoryArchive.astro';
import HistoryNotice from '../components/HistoryNotice.astro';
import { loadHistory } from '../lib/history';
import { path } from '../lib/paths';
const entries = await loadHistory();
---
<BaseLayout title="歷史時間軸"><div class="page-head"><span class="eyebrow">A STORY IN TIME</span><h1>沿著時間，聽見故事。</h1><p class="lead">從成立、作品發行與合作，到巡演與重要里程碑，按年份閱讀已查核的歷史。</p><a class="text-link" href={path('eras/')}>先讀分階段作品導讀 →</a></div><HistoryNotice/><HistoryArchive entries={entries}/></BaseLayout>
