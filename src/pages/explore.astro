---
import BaseLayout from '../layouts/BaseLayout.astro';import {loadContent} from '../lib/content';import {path} from '../lib/paths';import {withContext} from '../lib/navigation';
const {songs}=await loadContent();const originals=songs.filter(s=>!s.data.versionOf&&s.data.kind!=='interlude');
const authors=[...new Set(originals.flatMap(s=>s.data.sourceWorks.items.flatMap(w=>w.author?[w.author]:[])))];const kinds=[...new Set(originals.flatMap(s=>s.data.sourceWorks.items.map(w=>w.kind)))];
---
<BaseLayout title="作品關係：原作作者、素材與不同版本" description="按原作作者、小說、信件與投稿素材探索 YOASOBI，連結相關歌曲、版本、EP、MV 與現場紀錄。">
<div class="page-head"><span class="eyebrow">EXPLORE / FOLLOW THE CONNECTIONS</span><h1>同一個作者，<br/>會帶來哪些不同的聲音？</h1><p class="lead">由人、故事和素材追查作品，再到歌曲頁的歷程串起 EP、MV、歌單與獎項。</p><div class="actions"><a href="#authors">按作者探索 ↓</a><a href="#materials">小說以外的素材 ↓</a><a href={path('records/')}>成績與獎項 →</a></div></div>
<article class="prose"><section id="authors"><h2>原作作者與對應歌曲</h2><p>作者依資料庫原署名保留；團體角色、譯詞者和 MV 製作者不混為小說作者。</p>{authors.map((author,index)=><details class="clip-details" id={`author-${index}`}><summary>{author} · {originals.filter(s=>s.data.sourceWorks.items.some(w=>w.author===author)).length} 首</summary><ul>{originals.filter(s=>s.data.sourceWorks.items.some(w=>w.author===author)).map(s=><li id={`song-${s.id}`}><a lang="ja" href={withContext(path(`songs/${s.id}/`),path('explore/')+`#author-${index}`)}>{s.data.titleJa}</a><p class="muted">{s.data.sourceWorks.items.map(w=>w.title).join('、')} · {s.data.releaseDate}</p><p>{s.data.summary}</p></li>)}</ul></details>)}</section>
<section id="materials"><h2>不是每首歌都來自獨立小說</h2>{kinds.map(kind=><section><h3>{kind}</h3><ul>{originals.filter(s=>s.data.sourceWorks.items.some(w=>w.kind===kind)).map(s=><li><a lang="ja" href={withContext(path(`songs/${s.id}/`),path('explore/')+'#materials')}>{s.data.titleJa}</a> · {s.data.sourceWorks.items.filter(w=>w.kind===kind).map(w=>w.title).join('、')}</li>)}</ul></section>)}</section>
<section><h2>同一故事的版本，另一本帳</h2><p>由原曲頁「其他版本」查英文演唱、重新編曲或 Remix，再看各版的發行、影像與署名。故事可共用，獎項與表演紀錄逐版核對。</p><a href={path('songs/')+'?kind=english'}>查英文版 →</a><p><a href={path('live/compare/')}>追查跨場次的選曲變化 →</a></p></section></article></BaseLayout>
