---
import BaseLayout from '../layouts/BaseLayout.astro';
import SongCard from '../components/SongCard.astro';
import { loadContent } from '../lib/content';
import { path } from '../lib/paths';
const { songs, guides, listeningPaths } = await loadContent();
const featured = listeningPaths.find(p=>p.id==='first-listen')?.data.songs.flatMap(item=>{const song=songs.find(s=>s.id===item.songId);return song?[song]:[];}) ?? [];
const introduction = guides.find(guide => guide.id === 'about')?.data.summary;
---
<BaseLayout title="從故事開始"><section class="hero"><div><span class="eyebrow">NOVEL INTO MUSIC / A BEGINNER'S GUIDE</span><h1>從一個故事，<br/>開始聽見 <em>YOASOBI。</em></h1><p class="lead">{introduction}</p><div class="actions"><a class="button" href={path('start/')}>開始認識 YOASOBI ↗</a><a class="text-link" href={path('live/prepare/')}>演唱會前，從這裡開始 →</a><a class="text-link" href={path('deep-listening/')}>已聽過，往故事深處走 →</a></div></div><div class="hero-art" aria-hidden="true"><span class="art-note">STORIES BECOME SOUND</span><b>夜<br/>あそび</b><span class="art-bottom">AYASE × IKURA<br/>物語と、音楽と。</span></div></section><section class="section"><div class="section-heading"><div><span class="eyebrow">01 / GET TO KNOW</span><h2>找到你的入門路線</h2></div></div><div class="route-grid">{[['about/','01','故事的起點','認識團體、成員與小說改編的創作概念。'],['songs/','02','一首歌的世界','閱讀歌曲背景，與官方 MV 一起聆聽。'],['live/prepare/','03','準備走進現場','從推薦聆聽路線與歌單紀錄開始準備。']].map(([href,n,title,desc]) => <a class="route-card" href={path(href)}><span class="eyebrow">{n}</span><h3>{title} ↗</h3><p>{desc}</p></a>)}</div></section><section class="section"><div class="section-heading"><div><span class="eyebrow">02 / SONG NOTES</span><h2>先聽一首，再讀一個故事</h2></div><a href={path('songs/')}>所有歌曲 →</a></div><div class="song-grid">{featured.map((song,i) => <SongCard song={song} index={i+1}/>)}</div></section></BaseLayout>

