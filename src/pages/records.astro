---
import BaseLayout from '../layouts/BaseLayout.astro';import {loadContent} from '../lib/content';import {path} from '../lib/paths';import {withContext} from '../lib/navigation';
const {songs}=await loadContent();const records=songs.flatMap(s=>s.data.achievements.map((a,index)=>({...a,song:s,id:`record-${s.id}-${index}`}))).sort((a,b)=>a.date.localeCompare(b.date));
import {achievementLabels as labels} from '../lib/songs';
const institutions=[...new Set(records.flatMap(r=>r.institution?[r.institution]:[]))].sort();
---
<BaseLayout title="成績、認證與獎項歷程" description="逐曲查閱有來源的 Billboard、ORICON、RIAJ、JASRAC 與 MTV 紀錄，保留榜單付日、認證年月與公告日期的差異。">
<div class="page-head"><span class="eyebrow">RECORDS / CONTEXT MATTERS</span><h1>成績，放回它的時間與範圍。</h1><p class="lead">{records.length} 項已核對紀錄。榜單、認證、作品獎與影片獎衡量不同事情，先讀口徑，再讀數字。</p></div>
<article class="prose" data-records><form class="archive-filter" hidden role="search" aria-label="查找成績與獎項"><div><label for="record-query">歌曲、機構或獎項</label><input id="record-query" name="q" type="search" placeholder="例如 JASRAC、RIAJ、群青"/></div><div><label for="record-type">紀錄類型</label><select id="record-type" name="type"><option value="">全部</option>{Object.entries(labels).map(([value,label])=><option value={value}>{label}</option>)}</select></div><div><label for="record-year">年份</label><select id="record-year" name="year"><option value="">全部</option>{[...new Set(records.map(r=>r.date.slice(0,4)))].map(y=><option>{y}</option>)}</select></div><div><label for="record-institution">統計／頒獎機構</label><select id="record-institution" name="institution"><option value="">全部機構</option>{institutions.map(name=><option>{name}</option>)}</select></div><button type="button" data-clear>清除篩選</button></form><p data-record-count role="status" aria-live="polite">共 {records.length} 項</p>
<p class="callout">日期是榜單付日、報導日期、認證年月或公告日，不能混讀。認證不是本站依播放數換算；英文版與 Remix 不繼承原曲成績。未收錄表示待查，並非從未獲獎。</p>
<ol class="evidence-list">{records.map(r=><li id={r.id} data-record-item data-type={r.type} data-institution={r.institution} data-year={r.date.slice(0,4)} data-search={[r.song.data.titleJa,r.title,r.institution,r.metric,r.description].filter(Boolean).join(' ')}><span class="eyebrow">{labels[r.type]}</span><h2><a href={withContext(path(`songs/${r.song.id}/`)+'#achievements',path('records/')+`#${r.id}`)} lang={r.song.data.language==='ja'?'ja':'en'}>{r.song.data.titleJa}</a> · {r.title}</h2><p class="muted">{r.dateBasis}：<time datetime={r.date}>{r.date}</time>{r.institution&&` · ${r.institution}`}</p><p>{r.description}</p><details><summary>來源與統計範圍</summary><p><a href={r.source.url} target="_blank" rel="noopener noreferrer">{r.source.title} ↗<span class="sr-only">（另開分頁）</span></a></p><p>{r.source.scope}</p></details></li>)}</ol>
<p class="empty" hidden data-record-empty>沒有符合的紀錄，試試其他名稱或清除篩選。</p><p><a href={path('history/')}>放回完整歷史時間軸 →</a></p></article></BaseLayout>
<script>
 import {normalizeSearch} from '../lib/search';
 import {withContext} from '../lib/navigation';
 const root=document.querySelector<HTMLElement>('[data-records]');if(root){const form=root.querySelector<HTMLFormElement>('form')!;const items=[...root.querySelectorAll<HTMLElement>('[data-record-item]')];const fields=['q','type','year','institution'];const field=(n:string)=>form.elements.namedItem(n) as HTMLInputElement|HTMLSelectElement;
 const restore=()=>{const p=new URLSearchParams(location.search);fields.forEach(n=>field(n).value=p.get(n)??'');};
 const searchable=new Map(items.map(item=>[item,normalizeSearch(item.dataset.search!)]));
 const filter=(save=true)=>{const needle=normalizeSearch(field('q').value);const url=new URL(location.href);if(save){fields.forEach(n=>field(n).value?url.searchParams.set(n,field(n).value):url.searchParams.delete(n));history.replaceState(null,'',url);}
 for(const item of items){item.hidden=!searchable.get(item)!.includes(needle)||(!!field('type').value&&item.dataset.type!==field('type').value)||(!!field('year').value&&item.dataset.year!==field('year').value);item.hidden ||= !!field('institution').value&&item.dataset.institution!==field('institution').value;const link=item.querySelector<HTMLAnchorElement>('h2 a')!;const destination=new URL(link.href);link.href=withContext(destination.pathname+'#achievements',url.pathname+url.search+`#${item.id}`);}
 const count=items.filter(i=>!i.hidden).length;root.querySelector('[data-record-count]')!.textContent=`找到 ${count} 項（共 ${items.length} 項）`;root.querySelector<HTMLElement>('[data-record-empty]')!.hidden=count>0;};
 form.hidden=false;form.addEventListener('submit',e=>e.preventDefault());form.addEventListener('input',()=>filter());form.addEventListener('change',()=>filter());form.querySelector('[data-clear]')!.addEventListener('click',()=>{form.reset();filter();});window.addEventListener('popstate',()=>{restore();filter(false);});restore();filter(false);}
</script>
