---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadContent } from '../../lib/content';
import { path } from '../../lib/paths';
import HistoryArchive from '../../components/HistoryArchive.astro';
import HistoryNotice from '../../components/HistoryNotice.astro';
import { loadHistory, liveTypes } from '../../lib/history';
const { concerts } = await loadContent();
const entries = (await loadHistory()).filter(e=>liveTypes.has(e.data.type));
---
<BaseLayout title="LIVE 演出歷史"><div class="page-head"><span class="eyebrow">LIVE ARCHIVE</span><h1>故事，走進現場。</h1><p class="lead">沿著單獨演出、巡演、音樂祭與海外舞台，認識 YOASOBI 的現場歷史。</p><div class="actions"><a class="button" href={path('live/prepare/')}>演唱會惡補 →</a><a href={path('live/stats/')}>歌單樣本與曲目 →</a><a href={path('live/videos/')}>官方現場影片 →</a></div></div><HistoryNotice/>{concerts.length>0 && <section class="section"><h2>歌單紀錄</h2><div class="route-grid">{concerts.map(c => <a class="route-card" href={path(`live/${c.id}/`)}><time datetime={c.data.date}>{c.data.date}</time><h3>{c.data.title}</h3><p>{c.data.city} · {c.data.venue}</p></a>)}</div></section>}<HistoryArchive entries={entries} context="live"/></BaseLayout>
