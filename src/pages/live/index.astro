---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadContent } from '../../lib/content';
import { path } from '../../lib/paths';
import HistoryArchive from '../../components/HistoryArchive.astro';
import HistoryNotice from '../../components/HistoryNotice.astro';
import { loadHistory, liveTypes } from '../../lib/history';
import PhotoGallery from '../../components/PhotoGallery.astro';
import { livePhotoStories } from '../../data/photos';
const { concerts } = await loadContent();
const entries = (await loadHistory()).filter(e=>liveTypes.has(e.data.type));
---
<BaseLayout title="LIVE 演出歷史"><div class="page-head"><span class="eyebrow">LIVE ARCHIVE</span><h1>故事，走進現場。</h1><p class="lead">沿著單獨演出、巡演、音樂祭與海外舞台，認識 YOASOBI 的現場歷史。</p><div class="actions"><a class="button" href={path('live/prepare/')}>演唱會惡補 →</a><a href={path('live/stats/')}>歌單樣本與曲目 →</a><a href={path('live/videos/')}>官方現場影片 →</a><a href={path('live/compare/')}>比較兩場歌單 →</a></div></div><PhotoGallery title="現場影像選輯" stories={livePhotoStories} collapsible/><HistoryNotice/>{concerts.length>0 && <section class="section"><h2>歌單紀錄</h2><div class="route-grid">{concerts.sort((a,b)=>b.data.date.localeCompare(a.data.date)).map(c => <a class="route-card" href={path(`live/${c.id}/`)}><span class="eyebrow">{c.data.eventType==='festival'?'音樂祭':'專場'} · {c.data.country==='日本'?'日本':'海外'}</span><p><time datetime={c.data.date}>{c.data.date}</time></p><h3>{c.data.title}</h3><p>{c.data.city} · {c.data.venue}</p></a>)}</div></section>}<HistoryArchive entries={entries} context="live"/></BaseLayout>
