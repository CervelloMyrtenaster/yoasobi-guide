---
import BaseLayout from '../../layouts/BaseLayout.astro';import YouTubeEmbed from '../../components/YouTubeEmbed.astro';import {loadContent} from '../../lib/content';import {path} from '../../lib/paths';import {withContext} from '../../lib/navigation';
const {songs}=await loadContent();const entries=songs.filter(s=>!s.data.versionOf).flatMap(song=>song.data.videos.filter(v=>v.kind==='live').map(video=>({song,video}))).sort((a,b)=>(a.video.performedOn??'9999').localeCompare(b.video.performedOn??'9999'));
const scenes={concert:'專場',festival:'音樂祭',tv:'電視節目',studio:'棚內演唱',online:'線上演出',other:'其他／待分類'};
const years=[...new Set(entries.flatMap(e=>e.video.performedOn?[e.video.performedOn.slice(0,4)]:[]))].sort();
---
<BaseLayout title="官方現場影片：依演出日期與場景探索" description="按影片明載的演出日期、專場、音樂祭、電視與棚內場景查官方公開演唱；未明載日期的片段另列，不推定上傳日為演出日。">
<div class="page-head"><span class="eyebrow">LIVE / WATCH AND LISTEN</span><h1>從一段現場，<br/>再認識一首歌。</h1><p class="lead">{entries.length} 支官方公開演唱。日期已明載的片段依演出日排列，其餘保留「未明載單一日期」，不按歌曲發行年冒充演出年。</p><div class="actions"><a href={path('live/prepare/')}>惡補路線 →</a><a href={path('live/stats/')}>完整歌單樣本 →</a></div></div>
<article class="prose" data-video-index><form class="archive-filter" hidden role="search" aria-label="查找官方演唱片段"><div><label for="clip-query">歌曲或活動</label><input id="clip-query" name="q" type="search"/></div><div><label for="clip-year">明載演出年份</label><select id="clip-year" name="year"><option value="">全部</option>{years.map(y=><option>{y}</option>)}<option value="unknown">未明載單一日期</option></select></div><div><label for="clip-scene">場景</label><select id="clip-scene" name="scene"><option value="">全部</option>{Object.entries(scenes).map(([id,label])=><option value={id}>{label}</option>)}</select></div><button type="button" data-clear>清除篩選</button></form><p data-clip-count role="status" aria-live="polite">共 {entries.length} 支</p>
<p>片段不取代全場歌單，節目與棚內演唱不混入專場統計。只有影片標題明載日期時才加入日期；跨日標題不擅選其中一天。展開後仍需點選播放才連線至 YouTube。</p>
{entries.map(({song,video})=><section id={`clip-${video.youtubeId.toLowerCase()}`} data-clip data-year={video.performedOn?.slice(0,4)??'unknown'} data-scene={video.scene??'other'} data-search={`${song.data.titleJa} ${song.data.titleZh.text} ${video.title}`}><span class="eyebrow">{scenes[video.scene??'other']}</span><h2 lang={song.data.language==='ja'?'ja':undefined}>{song.data.titleJa}</h2><p class="muted">{video.performedOn?<>演出日期：<time datetime={video.performedOn}>{video.performedOn}</time></>:'未明載單一演出日期'}</p><a href={withContext(path(`songs/${song.id}/`),path('live/videos/')+`#clip-${video.youtubeId.toLowerCase()}`)}>閱讀故事、版本與歌曲歷程 →</a>{video.concertId&&<p><a href={path(`live/${video.concertId}/`)}>對照同日完整歌單 →</a></p>}<details class="clip-details"><summary>{video.title}</summary><YouTubeEmbed id={video.youtubeId} title={video.title} kind="live" externalOnly={video.externalOnly} restrictionNote={video.restrictionNote} headingLevel={3}/></details></section>)}
<p class="empty" hidden data-no-clips>沒有符合的片段，試試其他名稱或清除篩選。</p><p class="muted">影片可播地區、年齡與嵌入限制由發布者及 YouTube 控制；所有片段保留外部入口。</p></article></BaseLayout>
<script>
 import {normalizeSearch} from '../../lib/search';
 import {withContext} from '../../lib/navigation';
 const root=document.querySelector<HTMLElement>('[data-video-index]');if(root){const form=root.querySelector<HTMLFormElement>('form')!;const entries=[...root.querySelectorAll<HTMLElement>('[data-clip]')];const names=['q','year','scene'];const field=(name:string)=>form.elements.namedItem(name) as HTMLInputElement|HTMLSelectElement;
 const searchable=new Map(entries.map(entry=>[entry,normalizeSearch(entry.dataset.search!)]));
 const restore=()=>{const p=new URLSearchParams(location.search);names.forEach(n=>field(n).value=p.get(n)??'');};const filter=(save=true)=>{const url=new URL(location.href);if(save){names.forEach(n=>field(n).value?url.searchParams.set(n,field(n).value):url.searchParams.delete(n));history.replaceState(null,'',url);}const q=normalizeSearch(field('q').value);for(const e of entries){e.hidden=!searchable.get(e)!.includes(q)||(!!field('year').value&&e.dataset.year!==field('year').value)||(!!field('scene').value&&e.dataset.scene!==field('scene').value);const link=e.querySelector<HTMLAnchorElement>('a')!;link.href=withContext(new URL(link.href).pathname,url.pathname+url.search+`#${e.id}`);}const count=entries.filter(e=>!e.hidden).length;root.querySelector('[data-clip-count]')!.textContent=`找到 ${count} 支（共 ${entries.length} 支）`;root.querySelector<HTMLElement>('[data-no-clips]')!.hidden=count>0;};form.hidden=false;form.addEventListener('submit',e=>e.preventDefault());form.addEventListener('input',()=>filter());form.addEventListener('change',()=>filter());form.querySelector('[data-clear]')!.addEventListener('click',()=>{form.reset();filter();});window.addEventListener('popstate',()=>{restore();filter(false);});restore();filter(false);}
</script>
