---
import BaseLayout from './BaseLayout.astro';
import SourceList from '../components/SourceList.astro';
import type { CollectionEntry } from 'astro:content';
interface Props { entry: CollectionEntry<'guides' | 'members'> }
const { entry } = Astro.props;
---
<BaseLayout title={entry.data.title} description={entry.data.summary}><div class="page-head"><span class="eyebrow">THE STORY / YOASOBI GUIDE</span><h1>{entry.data.title}</h1><p class="lead">{entry.data.summary}</p></div><article class="prose"><slot/><SourceList sources={entry.data.sources} updatedAt={entry.data.updatedAt}/></article></BaseLayout>
